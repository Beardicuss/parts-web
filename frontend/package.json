{
  "name": "parts-catalog-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ../scripts/clean-dist.mjs && vite build",
    "build:verify": "node ../scripts/verify-production-bundle.mjs",
    "images:generate": "node ../scripts/generate-image-variants.mjs",
    "perf:budget": "node ../scripts/check-performance-budgets.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit": "npm audit --audit-level=critical",
    "db:seed:generate": "node ../scripts/generate-seed.mjs",
    "db:seed:check": "node ../scripts/generate-seed.mjs --check",
    "db:validate": "node ../scripts/validate-catalog.mjs",
    "db:check": "npm run db:seed:check && npm run db:validate"
  },
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
